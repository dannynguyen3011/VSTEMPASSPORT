# ─── MongoDB (Atlas) ──────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Database → Connect → Drivers
# Use the same cluster/URI for local dev and production (Vercel) deploys
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greenstemcompass

# ─── Auth (custom JWT sessions) ───────────────────────────────────────────────
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── ChromaDB (Vector Database for RAG) ──────────────────────────────────────
# Self-hosted on Railway or localhost for dev
# Railway: Deploy chromadb/chroma Docker image, copy the public URL
CHROMA_URL=http://localhost:8000

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin Access Control ─────────────────────────────────────────────────────
# Comma-separated MongoDB ObjectId strings (24 hex chars) with admin privileges
# Get user ids from the `users` collection's `_id` field (Atlas UI or mongosh)
ADMIN_USER_IDS=xxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyy

# ─── Data Freshness ───────────────────────────────────────────────────────────
# Last date the RAG corpus was re-ingested (displayed in chatbot disclaimer)
RAG_DATA_FRESHNESS_DATE=2026-04-01

# ─── Resend (Email — TrustFactor Tier 2 teacher verification) ─────────────────
# Get from: https://resend.com → API Keys
# Optional for MVP (Tier 2 uses admin manual review fallback)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@greenstemcompass.vn

# ─── Rocket.Chat (admin notifications) ────────────────────────────────────────
# Incoming webhook URL — Admin panel → Integrations → New → Incoming.
# Full URL including the token, e.g. http://localhost:3030/hooks/<id>/<token>
# Optional — if unset, notifications are silently skipped.
ROCKETCHAT_WEBHOOK_URL=
