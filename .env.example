# ─── Supabase (PostgreSQL + Auth) ────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here    # Never expose to client!

# ─── PostgreSQL Direct Connection ─────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string
# Use "Transaction" pooler URL for serverless (Next.js API routes)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres

# ─── OpenRouter (LLM + embeddings for RAG chatbot) ───────────────────────────
# Get from: https://openrouter.ai/keys — one key covers both the chat
# completion call and the embedding calls.
OPENROUTER_API_KEY=sk-or-...

# Embedding model, used identically at ingest time and query time (changing
# this requires re-running rag:ingest — vector spaces aren't compatible
# across models). BAAI/bge-m3: strong multilingual/Vietnamese retrieval,
# ~$0.01/M tokens.
OPENROUTER_EMBEDDING_MODEL=BAAI/bge-m3

# Chat/answer-generation model. Required — no code default, because
# OpenRouter's free-tier model roster changes weekly (models get delisted
# without notice). Pick a current multilingual free model from
# https://openrouter.ai/collections/free-models for testing, or a paid
# model (e.g. anthropic/claude-sonnet-4-6) for production quality.
OPENROUTER_LLM_MODEL=

# ─── ChromaDB (Vector Database for RAG) ──────────────────────────────────────
# Self-hosted on Railway or localhost for dev
# Railway: Deploy chromadb/chroma Docker image, copy the public URL
CHROMA_URL=http://localhost:8000

# Cosine-distance cutoff for retrieval (smaller = more similar); passages
# above this are treated as "not relevant" and excluded from the LLM
# context. Placeholder default — tune against docs/rag-eval-set.md once
# real corpus data is loaded.
RAG_SIMILARITY_THRESHOLD=0.45

# Override the Chroma collection name — set to green_stem_corpus_fixtures
# to test against the synthetic fixture corpus (test/fixtures/rag-corpus)
# instead of production data. Leave unset for production.
RAG_COLLECTION_NAME=

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin Access Control ─────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs with admin privileges
# Get user UUIDs from: Supabase → Authentication → Users
ADMIN_USER_IDS=uuid-1,uuid-2

# ─── Data Freshness ───────────────────────────────────────────────────────────
# Last date the RAG corpus was re-ingested (displayed in chatbot disclaimer)
RAG_DATA_FRESHNESS_DATE=2026-04-01

# ─── Resend (Email — TrustFactor Tier 2 teacher verification) ─────────────────
# Get from: https://resend.com → API Keys
# Optional for MVP (Tier 2 uses admin manual review fallback)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@greenstemcompass.vn

# ─── Rocket.Chat (admin notifications) ────────────────────────────────────────
# Incoming webhook URL — Admin panel → Integrations → New → Incoming.
# Full URL including the token, e.g. http://localhost:3030/hooks/<id>/<token>
# Optional — if unset, notifications are silently skipped.
ROCKETCHAT_WEBHOOK_URL=
