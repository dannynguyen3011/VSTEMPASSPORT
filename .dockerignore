# ─── Files KHÔNG copy vào Docker image ──────────────────────────────────────
# Giữ image nhỏ và tránh leak secrets

# Dependencies (sẽ install lại trong container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
.next
out
dist

# Environment files — TUYỆT ĐỐI KHÔNG copy vào image
.env
.env.local
.env.*.local
.env.development
.env.production

# Git
.git
.gitignore
.gitattributes

# IDE / editor
.vscode
.idea
*.swp
*.swo
.DS_Store

# Docs (không cần trong runtime)
README.md
*.md
docs

# Test files
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage

# Docker files (tránh recursive)
Dockerfile
Dockerfile.dev
docker-compose*.yml
.dockerignore

# Vercel
.vercel

# Misc
.eslintcache
*.log
data
.cache
